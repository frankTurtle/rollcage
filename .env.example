# Copy to .env for local live-mode runs. Never commit .env.
# Placeholders only. Values below are not real.

# Required only for live LLM mode (DEMO_LIVE=1). Tests and default demos never read it.
ANTHROPIC_API_KEY=your-api-key-here

# Optional. Overrides the default model set in shared/ts/src/config.ts.
# ANTHROPIC_MODEL=

# Set to 1 to make demos call the live API instead of recorded responses.
# DEMO_LIVE=0
