+import type { Cart } from './types';
+
+export interface DiscountRule {
+  code: string;
+  percent: number;
+  minSubtotal: number;
+}
+
+const RULES: DiscountRule[] = [
+  { code: 'WELCOME10', percent: 10, minSubtotal: 0 },
+  { code: 'BULK20', percent: 20, minSubtotal: 200 },
+];
+
+export function applyDiscount(cart: Cart, code: string): number {
+  const rule = RULES.find((r) => r.code === code);
+  if (!rule) return cart.subtotal;
+  if (cart.subtotal < rule.minSubtotal) return cart.subtotal;
+  const discounted = cart.subtotal * (1 - rule.percent / 100);
+  return Math.round(discounted * 100) / 100;
+}
+
+export function listCodes(): string[] {
+  return RULES.map((r) => r.code);
+}
