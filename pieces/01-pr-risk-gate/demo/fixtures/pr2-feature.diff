+import { describe, expect, it } from 'vitest';
+import { applyDiscount } from '../../src/cart/discount';
+
+describe('applyDiscount', () => {
+  it('applies a percentage', () => {
+    expect(applyDiscount({ subtotal: 100 }, 'WELCOME10')).toBe(90);
+  });
+  it('ignores unknown codes', () => {
+    expect(applyDiscount({ subtotal: 100 }, 'NOPE')).toBe(100);
+  });
+  it('respects the minimum subtotal', () => {
+    expect(applyDiscount({ subtotal: 50 }, 'BULK20')).toBe(50);
+  });
+});
